# Normalize to LF in the repo, native in the working copy.
* text=auto

# Must stay LF or they break on the far side.
*.sh        text eol=lf
gradlew     text eol=lf
*.py        text eol=lf
*.kt        text eol=lf
*.java      text eol=lf
*.xml       text eol=lf
*.gradle    text eol=lf
*.pro       text eol=lf

# Windows-only scripts: CRLF.
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary — never touch.
*.apk       binary
*.aab       binary
*.keystore  binary
*.jar       binary
*.png       binary
*.jpg       binary
